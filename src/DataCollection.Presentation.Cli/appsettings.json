{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": ["Console"],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "Scraper": {
    "AcmBaseUrl": "https://dl-acm-org.libproxy1.nus.edu.sg"
  },
  "Paths": {
    "PythonDLL": ".\\.venv\\python312.dll"
  },
  "BugListDiscovery": {
    "MaxDisplayResults": 10,
    "MaxTitleLength": 50,
    "HighConfidenceThreshold": 0.8,
    "PdfAnalysisConfidence": 0.9,
    "KeywordAnalysisConfidence": 0.95,
    "RepositoryAnalysisConfidence": 0.85
  },
  "BugDiscovery": {
    "PdfAnalysisConfidence": 0.9,
    "KeywordAnalysisConfidence": 0.95,
    "RepositoryAnalysisConfidence": 0.85,
    "WebSearchConfidenceMultiplier": 0.8,
    "LlmVerificationMultiplier": 1.2,
    "HighConfidenceThreshold": 0.8,
    "MinBugListConfidence": 0.7,
    "MinRepositoryConfidence": 0.6,
    "MaxSearchAttempts": 5,
    "RepositoryRetryDelayMs": 1000,
    "ContextWindowSize": 200,
    "MaxTextLengthForLlm": 4000,
    "MaxConcurrentOperations": 5,
    "MaxResultsPerSearch": 10,
    "EnablePdfAnalysis": true,
    "EnableRepositoryAnalysis": true,
    "EnableWebSearch": true,
    "EnableLlmVerification": false,
    "EnableParallelProcessing": true,
    "EnableDetailedLogging": false,
    "EnableCaching": true
  },
  "PdfAnalysis": {
    "ContextWindowSize": 200,
    "MaxTextLengthForProcessing": 4000,
    "MinSentenceLength": 10,
    "MaxSentenceLength": 500,
    "ParagraphBreakThreshold": 5.0,
    "IndentationThreshold": 10.0,
    "MinLineLength": 3,
    "EnableHyphenHandling": true,
    "EnableParagraphReconstruction": true,
    "EnableBulletPointDetection": true,
    "EnableKeywordNormalization": true,
    "EnableSentenceFiltering": true
  },
  "PatternMatching": {
    "ContextWindowSize": 150,
    "CacheExpirationMinutes": 10,
    "ConfidenceScores": {
      "PdfAnalysis": 0.85,
      "KeywordAnalysis": 0.92,
      "RepositoryAnalysis": 0.88,
      "WebSearch": 0.75,
      "Default": 0.65
    },
    "ConfidenceBoosts": [
      {
        "MatchCountThreshold": 40,
        "BoostValue": 0.12
      },
      {
        "MatchCountThreshold": 8,
        "BoostValue": 0.06
      }
    ],
    "UrlCleaningSuffixes": [
      ".",
      ",",
      ";",
      ")",
      "]",
      "}",
      " ",
      "\t",
      "\n",
      "\r",
      "<"
    ]
  },
  "ProcedureAnalysis": {
    "DefaultBugTablesPattern": "Table\\d+:*[^\\s]*bugs",
    "DefaultTechniquesPattern": "(differential.{1}testing|metamorphic.{1}testing|property-based|fuzzing)",
    "DefaultBugPattern": "\\b(?:bug|bugs)\\b",
    "DefaultTempBugTablesFile": "bug-tables.json",
    "DefaultTempTechniquesFile": "techniques.json",
    "DefaultOutputFile": "research-analysis.json",
    "DefaultTerminologyFile": "bug-terminology-analysis.json",
    "DefaultOutputDirectory": "analysis-results",
    "DefaultKeepTempFiles": false,
    "DefaultAdjectivesOnly": false,
    "MaxPatternLength": 1000,
    "MaxFileNameLength": 50
  }
}
